+      id: backups.id,
+      filename: backups.filename,
+      version: backups.version,
+      size: backups.size,
+      checksum: backups.checksum,
+      source: backups.source,
+      createdAt: backups.createdAt,
+    })
+    .from(backups)
+    .orderBy(desc(backups.createdAt));
