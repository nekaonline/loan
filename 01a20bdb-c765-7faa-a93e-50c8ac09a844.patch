+        `SELECT setval('${sequence}_id_seq', (SELECT COALESCE(MAX(id), 1) FROM ${sequence}))`
+      );
+    }
+
+    await client.query("COMMIT");
+  } catch (error) {
+    await client.query("ROLLBACK");
+    throw error;
+  } finally {
+    client.release();
+  }
