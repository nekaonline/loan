new file mode 100644
index 0000000..9feecbb
--- /dev/null
+++ b/src/app/api/attachments/[id]/route.ts
@@ -0,0 +1,58 @@
+import { NextRequest, NextResponse } from "next/server";
+import { readFile, unlink } from "node:fs/promises";
+import { db } from "@/db";
+import { attachments } from "@/db/schema";
+import { eq } from "drizzle-orm";
+import { getSession } from "@/lib/auth";
+import { ensureSchema } from "@/lib/schema-setup";
+import { safeUploadPath } from "@/lib/uploads";
+
+export const runtime = "nodejs";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(_req: NextRequest, { params }: Context) {
+  const session = await getSession();
+  if (!session) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  await ensureSchema();
+
+  const id = Number((await params).id);
+  const [file] = await db.select().from(attachments).where(eq(attachments.id, id)).limit(1);
+  if (!file) {
+    return NextResponse.json({ error: "فایل یافت نشد" }, { status: 404 });
+  }
+
+  try {
+    const content = await readFile(safeUploadPath(file.storedName));
+    return new NextResponse(content, {
+      headers: {
+        "Content-Type": file.mimeType || "application/octet-stream",
+        "Content-Disposition": `attachment; filename="${encodeURIComponent(file.fileName)}"`,
+      },
+    });
+  } catch {
+    return NextResponse.json({ error: "فایل روی دیسک یافت نشد" }, { status: 404 });
+  }
+}
+
+export async function DELETE(_req: NextRequest, { params }: Context) {
+  const session = await getSession();
+  if (!session) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  if (session.role === "viewer")
+    return NextResponse.json({ error: "دسترسی محدود" }, { status: 403 });
+  await ensureSchema();
+
+  const id = Number((await params).id);
+  const [file] = await db.select().from(attachments).where(eq(attachments.id, id)).limit(1);
+  if (!file) {
+    return NextResponse.json({ error: "فایل یافت نشد" }, { status: 404 });
+  }
+
+  await db.delete(attachments).where(eq(attachments.id, id));
+  try {
+    await unlink(safeUploadPath(file.storedName));
+  } catch {
+    // Missing file on disk should not block deleting the database row.
+  }
+  return NextResponse.json({ success: true });
+}
diff --git a/src/app/api/attachments/route.ts b/src/app/api/attachments/route.ts
new file mode 100644
index 0000000..8e563d2
--- /dev/null
+++ b/src/app/api/attachments/route.ts
@@ -0,0 +1,90 @@
+import { NextRequest, NextResponse } from "next/server";
+import { writeFile } from "node:fs/promises";
+import { db } from "@/db";
+import { attachments, loans } from "@/db/schema";
+import { desc, eq } from "drizzle-orm";
+import { getSession } from "@/lib/auth";
+import { ensureSchema } from "@/lib/schema-setup";
+import {
+  ensureUploadDir,
+  isAllowedUpload,
+  makeStoredName,
+  MAX_UPLOAD_SIZE,
+  safeUploadPath,
+} from "@/lib/uploads";
+
+export const runtime = "nodejs";
+
+export async function GET(req: NextRequest) {
+  const session = await getSession();
+  if (!session) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  await ensureSchema();
+
+  const loanId = Number(new URL(req.url).searchParams.get("loanId"));
+  if (!loanId) {
+    return NextResponse.json({ error: "شناسه وام معتبر نیست" }, { status: 400 });
+  }
+
+  const list = await db
+    .select()
+    .from(attachments)
+    .where(eq(attachments.loanId, loanId))
+    .orderBy(desc(attachments.createdAt));
+  return NextResponse.json({ attachments: list });
+}
+
+export async function POST(req: NextRequest) {
+  const session = await getSession();
+  if (!session) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  if (session.role === "viewer")
+    return NextResponse.json({ error: "دسترسی محدود" }, { status: 403 });
+  await ensureSchema();
+
+  const form = await req.formData();
+  const file = form.get("file");
+  const loanId = Number(form.get("loanId"));
+  const category = String(form.get("category") || "other");
+  const description = String(form.get("description") || "");
+
+  if (!(file instanceof File) || file.size === 0) {
+    return NextResponse.json({ error: "فایلی انتخاب نشده است" }, { status: 400 });
+  }
+  if (!isAllowedUpload(file.type)) {
+    return NextResponse.json(
+      { error: "فقط فایل‌های PDF و تصویر مجاز هستند" },
+      { status: 400 }
+    );
+  }
+  if (file.size > MAX_UPLOAD_SIZE) {
+    return NextResponse.json(
+      { error: "حجم فایل نباید بیشتر از ۵ مگابایت باشد" },
+      { status: 400 }
+    );
+  }
+
+  const [loan] = await db.select().from(loans).where(eq(loans.id, loanId)).limit(1);
+  if (!loan) {
+    return NextResponse.json({ error: "وام یافت نشد" }, { status: 404 });
+  }
+
+  const storedName = makeStoredName(file.type, file.name);
+  await ensureUploadDir();
+  await writeFile(safeUploadPath(storedName), Buffer.from(await file.arrayBuffer()));
+
+  const [created] = await db
+    .insert(attachments)
+    .values({
+      loanId,
+      memberId: loan.memberId,
+      storedName,
+      fileName: file.name.slice(0, 255),
+      mimeType: file.type,
+      fileSize: file.size,
+      category,
+      description: description || null,
+      uploadedBy: session.userId,
+    })
+    .returning();
+
+  return NextResponse.json({ attachment: created }, { status: 201 });
+}
