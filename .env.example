# Copy this file to `.env.local` (or `.env`) and adjust the values.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:123@127.0.0.1:5432/loan_db

# Secret used to sign login tokens. CHANGE THIS to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: extra hostnames allowed to open the app in `npm run dev`
# (LAN IPs 192.168.*, 10.*, 172.* and this PC's name/IPs are allowed automatically)
# ALLOWED_DEV_ORIGINS=loan.local,reception-pc

# Optional: force the login cookie's Secure flag. Leave unset for auto-detect
# (Secure only when the app is opened over https).
# COOKIE_SECURE=true
